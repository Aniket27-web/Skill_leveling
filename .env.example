# AI Mock Interview Coach - Root Environment Configuration

# Server & Networking
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECRET_KEY=super-secret-jwt-key-for-ai-mock-interview-coach-min-32-chars
# Legacy credential-encryption setting; the app now uses one server-configured AI provider.
CREDENTIAL_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default, PostgreSQL supported)
DATABASE_URL=sqlite:///./interview_coach.db

# -------------------------------------------------------------
# AI Engine & LLM Configuration (backend/app/ai)
# -------------------------------------------------------------
# Options for LLM_PROVIDER: "gemini" | "openai" | "anthropic" | "openai_compatible" | "fake"
LLM_PROVIDER=fake

# Set the application-wide provider key here; never put it in a VITE_ frontend variable.
LLM_API_KEY=

# Choose corresponding model:
# For Gemini: gemini-3.8-flash (current default)
# For OpenAI: gpt-5.5
# For Anthropic: claude-sonnet-5
LLM_MODEL=

# Required only for LLM_PROVIDER=openai_compatible
LLM_BASE_URL=

# Options when LLM_PROVIDER=fake: "ok" | "timeout" | "rate_limit" | "empty" | "malformed" | "out_of_range"
LLM_FAKE_MODE=ok
