# AI Mock Interview Coach - Root Environment Configuration

# Server & Networking
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECRET_KEY=super-secret-jwt-key-for-ai-mock-interview-coach-min-32-chars
# Set a strong, persistent value in production; used to encrypt per-user provider keys.
CREDENTIAL_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default, PostgreSQL supported)
DATABASE_URL=sqlite:///./interview_coach.db

# -------------------------------------------------------------
# AI Engine & LLM Configuration (backend/app/ai)
# -------------------------------------------------------------
# Options for LLM_PROVIDER: "gemini" | "openai" | "anthropic" | "fake"
LLM_PROVIDER=fake

# ADD YOUR AI API KEY HERE (leave blank if LLM_PROVIDER=fake)
LLM_API_KEY=

# Choose corresponding model:
# For Gemini: gemini-3.8-flash (current default)
# For OpenAI: gpt-5.5
# For Anthropic: claude-sonnet-5
LLM_MODEL=

# Options when LLM_PROVIDER=fake: "ok" | "timeout" | "rate_limit" | "empty" | "malformed" | "out_of_range"
LLM_FAKE_MODE=ok
