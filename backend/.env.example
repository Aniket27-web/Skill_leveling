# Backend API Configuration
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECRET_KEY=super-secret-jwt-key-for-ai-mock-interview-coach-min-32-chars
CREDENTIAL_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./interview_coach.db

# -------------------------------------------------------------
# AI Engine & LLM Configuration (backend/app/ai)
# -------------------------------------------------------------
# Options: "gemini" | "openai" | "anthropic" | "fake"
LLM_PROVIDER=fake

# ADD YOUR AI API KEY HERE (leave blank if LLM_PROVIDER=fake)
LLM_API_KEY=

# Model name:
# Gemini: gemini-3.8-flash | OpenAI: gpt-5.5 | Anthropic: claude-sonnet-5
LLM_MODEL=

LLM_FAKE_MODE=ok

